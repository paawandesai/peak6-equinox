# OWNER: shared. Operator may update to match reality; every change is logged in docs/decisions.md.
# Copy to .env for local runs. Never commit .env. See docs/environment.md.
APP_ENV=local
PORT=8080
DATABASE_URL=postgres://equinox:equinox@localhost:5432/equinox?sslmode=disable
DATABASE_URL_TEST=postgres://equinox:equinox@localhost:5432/equinox_test?sslmode=disable
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-local-only-000000000
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
UNIVERSE_DIR=config/universe
FACTS_FILE=config/facts.yaml
EVAL_SUMMARY_FILE=config/eval_summary.json
HTTP_TIMEOUT_SECONDS=10
MAX_BODY_BYTES=10485760
STALE_AFTER_SECONDS=120
SKEW_WARN_SECONDS=5
SKEW_MAX_SECONDS=30
MIN_ROUTE_CONFIDENCE=0.9
REVIEW_EDGE_MIN=0.02
PUBLIC_RATE_LIMIT_PER_MIN=60
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_DAILY_CALL_CAP=200
LLM_MAX_OUTPUT_TOKENS=400
LOG_LEVEL=info
